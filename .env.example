# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="https://your-subdomain.example.com"

# Public origin used by Twilio status callbacks (must be HTTPS in prod)
PUBLIC_BASE_URL="https://your-subdomain.example.com"

# Twilio (required)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# App
APP_TIMEZONE="Australia/Melbourne"
COMPANY_NAME="My Security Co"
