# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="https://your-subdomain.example.com"

# Public origin used by Twilio status callbacks (must be HTTPS in prod)
PUBLIC_BASE_URL="https://your-subdomain.example.com"

# Twilio (required)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# App
APP_TIMEZONE="Australia/Melbourne"
COMPANY_NAME="My Security Co"

# Licence expiry reminders. Vercel Cron calls /api/cron/licence-alerts daily
# (see vercel.json) and sends this value as a Bearer token. Any long random
# string; without it the job is disabled.
CRON_SECRET=""

# Optional: automatic NSW security licence lookups via API NSW
# (api.nsw.gov.au -> product "Security"). Leave blank to check NSW licences
# manually against the public register like every other state.
NSW_API_KEY=""
NSW_API_SECRET=""

# Local development only: log SMS to the console instead of sending via Twilio.
# Never set this in production.
# SMS_MODE="mock"

# Xero (optional). Register a Web app at developer.xero.com with the redirect
# URI https://<your-domain>/api/integrations/xero/callback.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Override only if Xero tells you to (defaults to granular scopes).
# XERO_SCOPES="openid profile email offline_access accounting.invoices accounting.contacts accounting.payments.read payroll.employees payroll.timesheets payroll.settings"

# Key for encrypting integration tokens at rest. Long random string. Falls
# back to NEXTAUTH_SECRET if unset; changing it means reconnecting Xero.
INTEGRATIONS_KEY=""
