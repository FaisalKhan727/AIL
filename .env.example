# Database — defaults to local SQLite, change to Postgres URL for production
DATABASE_URL="file:./dev.db"

# Auth — generate any random string for dev
NEXTAUTH_SECRET="dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# SMS mode — "mock" or "twilio"
SMS_MODE="mock"

# Twilio (only required when SMS_MODE=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# App
APP_TIMEZONE="Australia/Melbourne"
COMPANY_NAME="My Security Co"
