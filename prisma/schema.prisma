generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  adminUsers AdminUser[]
  guards     Guard[]
  sites      Site[]
  rosters    Roster[]
  settings   Setting[]
  licences   Licence[]
  // SaaS tier. Changed by Vigilo staff, not by the customer.
  plan       String    @default("PROFESSIONAL") // STARTER | PROFESSIONAL | ENTERPRISE
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("MANAGER") // OWNER | MANAGER
  createdAt    DateTime @default(now())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Guard {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  email         String?
  licenceNumber String?
  licenceExpiry DateTime?
  payRate       Decimal?
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  shifts        Shift[]
  smsLogs       SmsLog[]
  licences      Licence[]
  // Set when the guard is supplied by a subcontractor rather than employed.
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  // Payroll
  employmentType     String  @default("CASUAL") // CASUAL | PART_TIME | FULL_TIME
  payrollRef         String? // employee code used in payroll exports
  externalEmployeeId String? // e.g. Xero Payroll EmployeeID

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
}

model Site {
  id             String          @id @default(cuid())
  name           String
  address        String
  contactName    String?
  contactPhone   String?
  notes          String?
  active         Boolean         @default(true)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  shifts         Shift[]
  shiftTemplates ShiftTemplate[]
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  billRate       Decimal? // $ per guard-hour charged to the client, ex GST

  @@index([companyId])
}

model ShiftTemplate {
  id                String   @id @default(cuid())
  siteId            String
  name              String
  startTime         String   // "HH:mm" 24-hour
  endTime           String   // "HH:mm" 24-hour
  crossesMidnight   Boolean  @default(false)
  role              String?
  notes             String?
  daysOfWeek        String   @default("MON,TUE,WED,THU,FRI,SAT,SUN")
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  payRateMultiplier Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@index([siteId])
}

model Roster {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  shifts      Shift[]

  @@index([companyId])
}

model Shift {
  id              String    @id @default(cuid())
  rosterId        String
  guardId         String?
  siteId          String
  templateId      String?
  startAt         DateTime
  endAt           DateTime
  role            String?
  notes           String?
  status          String    @default("PENDING") // PENDING|CONFIRMED|REJECTED|WORKED|NO_SHOW|CANCELLED
  confirmCode     String    @unique
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  workedStart     DateTime?
  workedEnd       DateTime?
  // Set by the guard app on clock-in / clock-out (null when the device
  // declined to share a location, or the times were entered by an admin).
  clockInAt       DateTime?
  clockOutAt      DateTime?
  clockInLat      Float?
  clockInLng      Float?
  clockOutLat     Float?
  clockOutLng     Float?
  // Timesheet. Hours = (worked end - worked start) - unpaid break.
  breakMins       Int       @default(0)
  tsStatus        String    @default("PENDING") // PENDING | APPROVED | DISPUTED
  tsNote          String?
  tsApprovedAt    DateTime?
  tsApprovedBy    String?
  payRunId        String? // set once included in a pay run; the timesheet is then locked
  invoiceId       String? // set once billed to the client on an hourly invoice
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  roster   Roster         @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  guard    Guard?         @relation(fields: [guardId], references: [id])
  site     Site           @relation(fields: [siteId], references: [id])
  template ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  smsLogs  SmsLog[]
  payRun   PayRun?        @relation(fields: [payRunId], references: [id], onDelete: SetNull)

  @@index([guardId])
  @@index([siteId])
  @@index([rosterId])
  @@index([templateId])
  @@index([startAt])
  @@index([payRunId])
  @@index([invoiceId])
}

model SmsLog {
  id          String   @id @default(cuid())
  guardId     String?
  shiftId     String?
  direction   String   // OUTBOUND | INBOUND
  fromNumber  String
  toNumber    String
  body        String
  providerSid String?
  status      String?  // queued|sent|delivered|failed|mock
  errorCode   String?
  receivedAt  DateTime @default(now())

  guard Guard? @relation(fields: [guardId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([guardId])
  @@index([direction])
  @@index([receivedAt])
}

model Timesheet {
  id         String    @id @default(cuid())
  guardId    String
  weekStart  DateTime
  weekEnd    DateTime
  totalHours Decimal
  totalPay   Decimal
  status     String    @default("DRAFT") // DRAFT | APPROVED | PAID
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())

  @@unique([guardId, weekStart])
}

model Setting {
  companyId String
  key       String
  value     String
  company   Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
}

// One row per credential a guard holds (security licence, first aid, RSA…).
// The legacy Guard.licenceNumber / licenceExpiry columns are kept in sync with
// the guard's primary security licence so older screens keep working.
model Licence {
  id            String    @id @default(cuid())
  companyId     String
  guardId       String
  type          String // key from LICENCE_TYPES in lib/licences.ts
  number        String
  state         String    @default("VIC") // issuing state / territory
  issueDate     DateTime?
  expiryDate    DateTime?
  verification  String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED | REJECTED
  source        String    @default("ADMIN") // ADMIN | GUARD | IMPORT
  verifiedAt    DateTime?
  verifiedBy    String? // admin display name at the time of verification
  verifyMethod  String? // MANUAL | REGISTER | API
  verifyNote    String?
  lastAlertDays Int? // smallest expiry threshold (in days) already alerted on
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  guard    Guard            @relation(fields: [guardId], references: [id], onDelete: Cascade)
  document LicenceDocument?
  events   LicenceEvent[]

  @@index([companyId])
  @@index([guardId])
  @@index([expiryDate])
}

// Photo / scan of the credential. Kept in its own table so list queries never
// drag the image bytes along.
model LicenceDocument {
  licenceId  String   @id
  mime       String
  name       String
  data       Bytes
  uploadedAt DateTime @default(now())

  licence Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)
}

// Append-only verification history for a licence.
model LicenceEvent {
  id        String   @id @default(cuid())
  licenceId String
  at        DateTime @default(now())
  actor     String // admin name, "Guard", or "System"
  action    String // CREATED | UPDATED | DOCUMENT | REGISTER_CHECK | VERIFIED | REJECTED | ALERT
  detail    String?

  licence Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)

  @@index([licenceId])
}

// One-time sign-in codes for the guard app. Only a hash of the code is stored.
model GuardOtp {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id               String    @id @default(cuid())
  companyId        String
  name             String
  abn              String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  billingEmail     String?
  contractStart    DateTime?
  contractEnd      DateTime?
  paymentTermsDays Int       @default(14)
  // Service levels the client is promised; actuals are computed from patrol
  // jobs and alarms.
  slaPatrolPct     Int       @default(95)
  slaAlarmMins     Int       @default(15)
  notes            String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  externalContactId String? // contact id in the connected accounting system

  sites    Site[]
  runs     PatrolRun[]
  invoices Invoice[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Alarm response
// ---------------------------------------------------------------------------

model Alarm {
  id           String    @id @default(cuid())
  companyId    String
  ref          Int // ALM-<ref>, sequential per company
  siteId       String
  zone         String?
  type         String
  priority     String // CRITICAL | HIGH | MEDIUM | LOW
  verification String    @default("UNVERIFIED") // UNVERIFIED | CCTV_CONFIRMED | GUARD_CONFIRMED | FALSE_ALARM
  status       String    @default("UNASSIGNED") // UNASSIGNED | DISPATCHED | EN_ROUTE | ON_SCENE | RESOLVED
  guardId      String?
  etaMins      Int?
  triggeredAt  DateTime  @default(now())
  dispatchedAt DateTime?
  onSceneAt    DateTime?
  resolvedAt   DateTime?
  resolvedBy   String?
  outcome      String?
  sopDone      Json      @default("[]") // indexes of ticked SOP steps

  events    AlarmEvent[]
  incidents Incident[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([guardId])
}

model AlarmEvent {
  id      String   @id @default(cuid())
  alarmId String
  at      DateTime @default(now())
  actor   String
  text    String

  alarm Alarm @relation(fields: [alarmId], references: [id], onDelete: Cascade)

  @@index([alarmId])
}

// ---------------------------------------------------------------------------
// Incidents
// ---------------------------------------------------------------------------

model Incident {
  id           String   @id @default(cuid())
  companyId    String
  ref          Int // INC-<ref>
  siteId       String
  guardId      String? // reporting guard
  alarmId      String?
  type         String
  severity     String // CRITICAL | HIGH | MEDIUM | LOW
  status       String   @default("OPEN") // OPEN | UNDER_REVIEW | ESCALATED | RESOLVED | ARCHIVED
  zone         String?
  narrative    String
  persons      String?
  lossValue    Decimal?
  assignedTo   String?
  notifyClient Boolean  @default(false)
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  alarm   Alarm?           @relation(fields: [alarmId], references: [id], onDelete: SetNull)
  updates IncidentUpdate[]
  photo   IncidentPhoto?

  @@unique([companyId, ref])
  @@index([companyId, status])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  at         DateTime @default(now())
  actor      String
  text       String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentPhoto {
  incidentId String @id
  mime       String
  data       Bytes

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Vehicles & equipment
// ---------------------------------------------------------------------------

model Vehicle {
  id              String    @id @default(cuid())
  companyId       String
  code            String // V-01
  rego            String
  make            String?
  model           String?
  year            Int?
  status          String    @default("ACTIVE") // ACTIVE | IN_SERVICE | DECOMMISSIONED
  odometer        Int?
  serviceDue      DateTime?
  insuranceExpiry DateTime?
  notes           String?

  checks VehicleCheck[]
  runs   PatrolRun[]

  @@index([companyId])
}

model VehicleCheck {
  id        String   @id @default(cuid())
  companyId String
  vehicleId String
  guardId   String?
  at        DateTime @default(now())
  odometer  Int?
  fuel      String?
  failed    Json     @default("[]") // labels of failed checklist items
  notes     String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
}

model Equipment {
  id        String  @id @default(cuid())
  companyId String
  name      String
  kind      String
  serial    String?
  status    String  @default("AVAILABLE") // AVAILABLE | IN_USE | MAINTENANCE | LOST
  guardId   String? // who has it
  notes     String?

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Patrol runs. A run is a reusable route billed to a client per completed
// run; a job is one night's execution of it. Deliberately separate from
// shifts/timesheets: patrol jobs drive client invoices, never payroll.
// ---------------------------------------------------------------------------

model PatrolRun {
  id        String  @id @default(cuid())
  companyId String
  code      String // R01
  name      String
  clientId  String?
  vehicleId String?
  rate      Decimal @default(0) // $ billed per fully completed run
  active    Boolean @default(true)

  client  Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vehicle Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops   PatrolStop[]
  jobs    PatrolJob[]

  @@index([companyId])
}

model PatrolStop {
  id           String  @id @default(cuid())
  runId        String
  position     Int
  name         String
  address      String?
  instructions String?

  run PatrolRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model PatrolJob {
  id          String    @id @default(cuid())
  companyId   String
  runId       String
  date        DateTime // date-only, UTC midnight
  guardId     String?
  status      String    @default("SCHEDULED") // SCHEDULED | ACTIVE | COMPLETED | PARTIAL | MISSED
  stopCount   Int // stops on the run when the job was created
  rate        Decimal // run rate at the time, so later price changes don't rewrite history
  startedAt   DateTime?
  completedAt DateTime?
  invoiceId   String?

  run   PatrolRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  scans PatrolScan[]

  @@index([companyId, date])
  @@index([guardId])
}

model PatrolScan {
  id       String   @id @default(cuid())
  jobId    String
  stopId   String
  stopName String
  status   String // SCANNED | MISSED
  at       DateTime @default(now())
  lat      Float?
  lng      Float?
  note     String?

  job PatrolJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stopId])
}

// ---------------------------------------------------------------------------
// Client invoicing (patrol work)
// ---------------------------------------------------------------------------

model Invoice {
  id          String    @id @default(cuid())
  companyId   String
  number      Int // INV-<number>
  clientId    String
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | VOID
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  gstRate     Decimal   @default(10)
  notes       String?
  createdAt   DateTime  @default(now())
  externalId       String? // id in the connected accounting system
  externalProvider String?
  syncedAt         DateTime?

  client   Client        @relation(fields: [clientId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal
  jobId       String? // patrol job this line bills, if any
  shiftId     String? // guard shift this line bills, if any

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Training
// ---------------------------------------------------------------------------

model Course {
  id            String   @id @default(cuid())
  companyId     String
  title         String
  category      String
  description   String?
  content       String // course material shown to the guard
  mandatory     Boolean  @default(false)
  renewalMonths Int? // certificate lifetime; null = never expires
  passMark      Int      @default(80)
  // [{ q: string, options: string[], answer: number }]
  questions     Json     @default("[]")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  enrollments Enrollment[]

  @@index([companyId])
}

model Enrollment {
  id          String    @id @default(cuid())
  companyId   String
  courseId    String
  guardId     String
  status      String    @default("ASSIGNED") // ASSIGNED | PASSED | FAILED
  dueAt       DateTime?
  score       Int?
  attempts    Int       @default(0)
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, guardId])
  @@index([guardId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Subcontractors
// ---------------------------------------------------------------------------

model Subcontractor {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  abn             String?
  contactName     String?
  phone           String?
  email           String?
  status          String    @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED
  specialties     String?
  insuranceExpiry DateTime?
  rating          Int?
  notes           String?
  createdAt       DateTime  @default(now())

  guards      Guard[]
  jobRequests JobRequest[]
  invoices    SubInvoice[]

  @@index([companyId])
}

model JobRequest {
  id              String   @id @default(cuid())
  companyId       String
  subcontractorId String
  siteId          String?
  description     String
  startDate       DateTime
  endDate         DateTime
  headcount       Int      @default(1)
  status          String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | COMPLETED
  createdAt       DateTime @default(now())

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SubInvoice {
  id              String   @id @default(cuid())
  companyId       String
  subcontractorId String
  number          String
  period          String?
  amount          Decimal
  status          String   @default("PENDING") // PENDING | APPROVED | PAID | DISPUTED
  note            String?
  receivedAt      DateTime @default(now())

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal
  paidOn    DateTime
  method    String   @default("BANK_TRANSFER") // BANK_TRANSFER | CARD | CHEQUE | CASH | OTHER
  reference String?
  source    String   @default("MANUAL") // MANUAL | XERO
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Payroll. Vigilo prepares pay runs (hours, award penalties, gross pay and
// super). Tax withholding and Single Touch Payroll reporting happen in the
// payroll system the run is exported to.
// ---------------------------------------------------------------------------

model PayRun {
  id          String    @id @default(cuid())
  companyId   String
  number      Int
  periodStart DateTime // date-only, first day of the period
  periodEnd   DateTime // date-only, last day of the period
  payDate     DateTime
  status      String    @default("DRAFT") // DRAFT | FINALISED
  superRate   Decimal // % at the time the run was calculated
  createdBy   String
  createdAt   DateTime  @default(now())
  finalisedAt DateTime?
  finalisedBy String?
  exportedAt  DateTime?
  exportedTo  String?

  lines  PayRunLine[]
  shifts Shift[]

  @@unique([companyId, number])
  @@index([companyId])
}

model PayRunLine {
  id         String   @id @default(cuid())
  payRunId   String
  guardId    String
  shiftId    String? // null for manual adjustments
  workDate   DateTime // local calendar date the hours fall on (date-only)
  category   String // ORDINARY | NIGHT | SATURDAY | SUNDAY | PUBLIC_HOLIDAY | OT_150 | OT_200 | OT_SUNDAY | OT_PUBLIC_HOLIDAY | ADJUSTMENT
  hours      Decimal
  baseRate   Decimal
  multiplier Decimal
  amount     Decimal
  superable  Boolean // counts toward ordinary time earnings
  note       String?

  payRun PayRun @relation(fields: [payRunId], references: [id], onDelete: Cascade)

  @@index([payRunId])
  @@index([guardId])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime // date-only
  name      String

  @@unique([companyId, date])
}

// ---------------------------------------------------------------------------
// Accounting / payroll system connections
// ---------------------------------------------------------------------------

model Integration {
  id              String    @id @default(cuid())
  companyId       String
  provider        String // XERO
  tenantId        String?
  tenantName      String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  settings        Json      @default("{}")
  connectedBy     String?
  connectedAt     DateTime  @default(now())

  @@unique([companyId, provider])
}

model SyncLog {
  id        String   @id @default(cuid())
  companyId String
  provider  String
  kind      String // INVOICE | CONTACT | PAYMENT | PAYRUN | EMPLOYEE | CONNECT
  ref       String?
  ok        Boolean
  message   String
  at        DateTime @default(now())

  @@index([companyId, at])
}
