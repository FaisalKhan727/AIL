generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  brandColour String? // hex, e.g. "#0B1E3F" — used as company stripe/badge in guard app
  createdAt   DateTime @default(now())

  adminUsers         AdminUser[]
  guards             Guard[]
  sites              Site[]
  rosters            Roster[]
  settings           Setting[]
  clockEvents        ClockEvent[]
  shiftCheckIns      ShiftCheckIn[]
  incidentReports    IncidentReport[]
  loneWorkerCheckIns LoneWorkerCheckIn[]
  alarmJobs          AlarmJob[]
  alarmContacts      AlarmContact[]
  alarmReports       AlarmReport[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("MANAGER") // OWNER | MANAGER
  createdAt    DateTime @default(now())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Guard {
  id                 String              @id @default(cuid())
  firstName          String
  lastName           String
  phone              String
  email              String?
  licenceNumber      String?
  licenceExpiry      DateTime?
  payRate            Decimal?
  notes              String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  companyId          String
  guardIdentityId    String? // links to cross-company GuardIdentity; nullable until backfill completes
  company            Company             @relation(fields: [companyId], references: [id])
  guardIdentity      GuardIdentity?      @relation(fields: [guardIdentityId], references: [id])
  shifts             Shift[]
  smsLogs            SmsLog[]
  setupTokens        SetupToken[]
  appDispatch        CompanyAppDispatch?
  clockEvents        ClockEvent[]
  shiftCheckIns      ShiftCheckIn[]
  incidentReports    IncidentReport[]
  loneWorkerCheckIns LoneWorkerCheckIn[]
  alarmResponders    AlarmResponder[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
  @@index([guardIdentityId])
}

model Site {
  id              String           @id @default(cuid())
  name            String
  address         String
  contactName     String?
  contactPhone    String?
  notes           String?
  active          Boolean          @default(true)
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  shifts          Shift[]
  shiftTemplates  ShiftTemplate[]
  incidentReports IncidentReport[]
  alarmJobs       AlarmJob[]

  @@index([companyId])
}

model ShiftTemplate {
  id                String   @id @default(cuid())
  siteId            String
  name              String
  startTime         String // "HH:mm" 24-hour
  endTime           String // "HH:mm" 24-hour
  crossesMidnight   Boolean  @default(false)
  role              String?
  notes             String?
  daysOfWeek        String   @default("MON,TUE,WED,THU,FRI,SAT,SUN")
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  payRateMultiplier Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@index([siteId])
}

model Roster {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  shifts      Shift[]

  @@index([companyId])
}

model Shift {
  id              String    @id @default(cuid())
  rosterId        String
  guardId         String?
  siteId          String
  templateId      String?
  startAt         DateTime
  endAt           DateTime
  role            String?
  notes           String?
  status          String    @default("PENDING") // PENDING|CONFIRMED|REJECTED|WORKED|NO_SHOW|CANCELLED
  confirmCode     String    @unique
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  workedStart     DateTime?
  workedEnd       DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  roster             Roster              @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  guard              Guard?              @relation(fields: [guardId], references: [id])
  site               Site                @relation(fields: [siteId], references: [id])
  template           ShiftTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  smsLogs            SmsLog[]
  clockEvents        ClockEvent[]
  shiftCheckIns      ShiftCheckIn[]
  incidentReports    IncidentReport[]
  loneWorkerCheckIns LoneWorkerCheckIn[]

  @@index([guardId])
  @@index([siteId])
  @@index([rosterId])
  @@index([templateId])
  @@index([startAt])
}

model SmsLog {
  id               String   @id @default(cuid())
  guardId          String?
  shiftId          String?
  alarmJobId       String?
  alarmResponderId String?
  direction        String // OUTBOUND | INBOUND
  fromNumber       String
  toNumber         String
  body             String
  providerSid      String?
  status           String? // queued|sent|delivered|failed|mock
  errorCode        String?
  receivedAt       DateTime @default(now())

  guard          Guard?          @relation(fields: [guardId], references: [id])
  shift          Shift?          @relation(fields: [shiftId], references: [id])
  alarmJob       AlarmJob?       @relation(fields: [alarmJobId], references: [id])
  alarmResponder AlarmResponder? @relation(fields: [alarmResponderId], references: [id])

  @@index([guardId])
  @@index([direction])
  @@index([receivedAt])
  @@index([alarmJobId])
  @@index([alarmResponderId])
}

model Timesheet {
  id         String    @id @default(cuid())
  guardId    String
  weekStart  DateTime
  weekEnd    DateTime
  totalHours Decimal
  totalPay   Decimal
  status     String    @default("DRAFT") // DRAFT | APPROVED | PAID
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())

  @@unique([guardId, weekStart])
}

model Setting {
  companyId String
  key       String
  value     String
  company   Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
}

// ---------------------------------------------------------------------------
// Guard PWA models (Phase 1 schema; behaviour gated per phase in application code)
// ---------------------------------------------------------------------------

// One human guard, regardless of which companies they work for.
// Identified globally by phone (E.164). Immutable identity record.
model GuardIdentity {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account     GuardAccount?
  employments Guard[]
  setupTokens SetupToken[]

  @@index([phone])
}

// App credentials + activation state for a GuardIdentity. 1:1 with GuardIdentity.
// Holds the PIN, T&C acceptance, last-seen, suspend state.
model GuardAccount {
  id                String        @id @default(cuid())
  guardIdentityId   String        @unique
  guardIdentity     GuardIdentity @relation(fields: [guardIdentityId], references: [id], onDelete: Cascade)
  pinHash           String?
  backupEmail       String?
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  appActivated      Boolean       @default(false)
  activatedAt       DateTime?
  lastSeenAt        DateTime?
  suspendedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sessions          GuardSession[]
  pushSubscriptions PushSubscription[]
  preferences       GuardPreferences?
}

// Long-lived opaque session tokens per device. Token stored hashed.
model GuardSession {
  id             String       @id @default(cuid())
  guardAccountId String
  guardAccount   GuardAccount @relation(fields: [guardAccountId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  lastUsedAt     DateTime     @default(now())
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([guardAccountId])
  @@index([expiresAt])
}

// Web Push subscription per device. Failures auto-prune in app code.
model PushSubscription {
  id                   String       @id @default(cuid())
  guardAccountId       String
  guardAccount         GuardAccount @relation(fields: [guardAccountId], references: [id], onDelete: Cascade)
  endpoint             String       @unique
  p256dhKey            String
  authKey              String
  deviceLabel          String?
  lastSuccessfulPushAt DateTime?
  lastFailedPushAt     DateTime?
  failureCount         Int          @default(0)
  createdAt            DateTime     @default(now())

  @@index([guardAccountId])
}

// One-time setup token sent via SMS when admin clicks "Send app invite".
// Scoped to a company's Guard record (who invited), optionally also to an
// existing GuardIdentity (if the phone already had one).
model SetupToken {
  id              String         @id @default(cuid())
  guardId         String
  guard           Guard          @relation(fields: [guardId], references: [id], onDelete: Cascade)
  guardIdentityId String?
  guardIdentity   GuardIdentity? @relation(fields: [guardIdentityId], references: [id])
  tokenHash       String         @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  ipAddress       String?
  createdAt       DateTime       @default(now())

  @@index([guardId])
  @@index([expiresAt])
}

// Per-GuardAccount preferences (identity-level, not per company).
// Per-company notification opt-out is the CompanyAppDispatch toggle.
model GuardPreferences {
  id                   String       @id @default(cuid())
  guardAccountId       String       @unique
  guardAccount         GuardAccount @relation(fields: [guardAccountId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean      @default(true)
  loneWorkerEnabled    Boolean      @default(true)
  language             String       @default("en")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// Per-company toggle: does this company dispatch to the guard's app (vs SMS)?
// Default true once the guard's GuardIdentity has app access; admin can flip.
model CompanyAppDispatch {
  id        String   @id @default(cuid())
  guardId   String   @unique
  guard     Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClockEvent {
  id               String   @id @default(cuid())
  shiftId          String
  shift            Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  guardId          String
  guard            Guard    @relation(fields: [guardId], references: [id])
  eventType        String // CLOCK_IN | CLOCK_OUT | BREAK_START | BREAK_END
  timestamp        DateTime @default(now())
  latitude         Decimal?
  longitude        Decimal?
  distanceFromSite Decimal? // metres
  flaggedDistance  Boolean  @default(false)
  photoUrl         String?
  notes            String?
  source           String   @default("GUARD_APP") // GUARD_APP | ADMIN_MANUAL | AUTO
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  createdAt        DateTime @default(now())

  @@index([shiftId])
  @@index([guardId])
  @@index([companyId])
  @@index([timestamp])
}

model ShiftCheckIn {
  id          String   @id @default(cuid())
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  guardId     String
  guard       Guard    @relation(fields: [guardId], references: [id])
  checkInType String // PHOTO | TEXT | VOLUNTARY
  prompt      String?
  photoUrl    String?
  notes       String?
  latitude    Decimal?
  longitude   Decimal?
  timestamp   DateTime @default(now())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())

  @@index([shiftId])
  @@index([guardId])
  @@index([companyId])
}

model IncidentReport {
  id               String    @id @default(cuid())
  shiftId          String?
  shift            Shift?    @relation(fields: [shiftId], references: [id])
  guardId          String
  guard            Guard     @relation(fields: [guardId], references: [id])
  siteId           String?
  site             Site?     @relation(fields: [siteId], references: [id])
  incidentType     String
  severity         String // LOW | MEDIUM | HIGH | CRITICAL
  occurredAt       DateTime
  description      String
  peopleInvolved   String?
  witnessesPresent Boolean   @default(false)
  policeCalled     Boolean   @default(false)
  policeDetails    String?
  ambulanceCalled  Boolean   @default(false)
  ambulanceDetails String?
  photoUrls        String? // JSON array of R2 URLs
  latitude         Decimal?
  longitude        Decimal?
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | RESOLVED
  reviewedBy       String?
  reviewedAt       DateTime?
  adminNotes       String?
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([guardId])
  @@index([companyId])
  @@index([status])
  @@index([severity])
}

model LoneWorkerCheckIn {
  id                String    @id @default(cuid())
  shiftId           String
  shift             Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  guardId           String
  guard             Guard     @relation(fields: [guardId], references: [id])
  scheduledAt       DateTime
  sentAt            DateTime?
  respondedAt       DateTime?
  response          String? // OK | HELP | SNOOZE | NO_RESPONSE
  responseLatitude  Decimal?
  responseLongitude Decimal?
  escalatedAt       DateTime?
  escalatedTo       String?
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  createdAt         DateTime  @default(now())

  @@index([shiftId])
  @@index([guardId])
  @@index([companyId])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// Alarm Dispatch (independent of roster module)
// ---------------------------------------------------------------------------

// One alarm callout. Docket is per-company sequential, sourced from a
// Setting key (alarm.nextDocket) at creation time. Status moves
// DISPATCHED → ACKNOWLEDGED → ONSITE → COMPLETED (or CANCELLED /
// NO_RESPONSE) driven by the inbound SMS parser or admin action.
model AlarmJob {
  id                  String    @id @default(cuid())
  companyId           String
  docket              String // per-company unique, human-readable (e.g. "59005")
  source              String // e.g. "Guardian Protective Services"
  sourceReference     String?
  alarmType           String // BURGLARY | FIRE | MEDICAL | PANIC | TAMPER | DURESS | OTHER
  priority            String    @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  siteName            String
  siteAddress         String
  siteLatitude        Decimal?
  siteLongitude       Decimal?
  siteId              String?
  clientName          String?
  clientEmail         String?
  clientPhone         String?
  receivedAt          DateTime  @default(now())
  description         String?
  specialInstructions String?
  status              String    @default("DISPATCHED") // DISPATCHED | ACKNOWLEDGED | ONSITE | COMPLETED | NO_RESPONSE | CANCELLED
  notes               String? // admin internal notes added post-hoc
  createdBy           String // FK to AdminUser.id (string, kept loose for now)
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  company    Company          @relation(fields: [companyId], references: [id])
  site       Site?            @relation(fields: [siteId], references: [id])
  responders AlarmResponder[]
  reports    AlarmReport[]
  smsLogs    SmsLog[]

  @@unique([companyId, docket])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, receivedAt])
  @@index([siteId])
}

// One row per dispatch attempt. Each AlarmJob may have multiple
// AlarmResponder rows (admin can send to a second responder if the
// first doesn't reply). The inbound parser matches incoming SMS to the
// AlarmResponder with the latest pending state for that phone.
model AlarmResponder {
  id                 String    @id @default(cuid())
  alarmJobId         String
  companyId          String
  responderType      String // INTERNAL_GUARD | EXTERNAL_CONTRACTOR
  guardId            String?
  externalName       String?
  externalPhone      String // E.164
  externalCompany    String?
  dispatchedAt       DateTime  @default(now())
  dispatchSmsLogId   String?
  acknowledgedAt     DateTime?
  declinedAt         DateTime?
  onsiteAt           DateTime?
  offsiteAt          DateTime?
  responseResult     String?
  responseRawBody    String?
  responseSmsLogId   String?

  alarmJob AlarmJob @relation(fields: [alarmJobId], references: [id], onDelete: Cascade)
  guard    Guard?   @relation(fields: [guardId], references: [id])
  smsLogs  SmsLog[]

  @@index([alarmJobId])
  @@index([externalPhone])
  @@index([guardId])
  @@index([companyId])
}

// Saved external contractors / frequent responders. Phone is unique per
// company so admin can type the number in New Alarm and the responder's
// name auto-fills.
model AlarmContact {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  phone      String // E.164
  company    String? // contractor's company name
  email      String?
  notes      String?
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  companyRef Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, phone])
  @@index([companyId, active])
}

// Generated PDF + (optional) email delivery state. Email fields are
// nullable because v1 ships without auto-send — admin downloads the PDF
// manually. Schema is forward-compatible for when email lands later.
model AlarmReport {
  id                  String    @id @default(cuid())
  companyId           String
  alarmJobId          String
  pdfUrl              String // R2 signed URL or storage key
  generatedAt         DateTime  @default(now())
  emailSentAt         DateTime?
  emailSentTo         String?
  emailDelivered      Boolean   @default(false)
  emailFailureReason  String?

  alarmJob AlarmJob @relation(fields: [alarmJobId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([alarmJobId])
  @@index([companyId])
}
