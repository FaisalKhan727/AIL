generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  adminUsers AdminUser[]
  guards     Guard[]
  sites      Site[]
  rosters    Roster[]
  settings   Setting[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("MANAGER") // OWNER | MANAGER
  createdAt    DateTime @default(now())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Guard {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  email         String?
  licenceNumber String?
  licenceExpiry DateTime?
  payRate       Decimal?
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  shifts        Shift[]
  smsLogs       SmsLog[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
}

model Site {
  id             String          @id @default(cuid())
  name           String
  address        String
  contactName    String?
  contactPhone   String?
  notes          String?
  active         Boolean         @default(true)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  shifts         Shift[]
  shiftTemplates ShiftTemplate[]

  @@index([companyId])
}

model ShiftTemplate {
  id                String   @id @default(cuid())
  siteId            String
  name              String
  startTime         String   // "HH:mm" 24-hour
  endTime           String   // "HH:mm" 24-hour
  crossesMidnight   Boolean  @default(false)
  role              String?
  notes             String?
  daysOfWeek        String   @default("MON,TUE,WED,THU,FRI,SAT,SUN")
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  payRateMultiplier Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@index([siteId])
}

model Roster {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  shifts      Shift[]

  @@index([companyId])
}

model Shift {
  id              String    @id @default(cuid())
  rosterId        String
  guardId         String?
  siteId          String
  templateId      String?
  startAt         DateTime
  endAt           DateTime
  role            String?
  notes           String?
  status          String    @default("PENDING") // PENDING|CONFIRMED|REJECTED|WORKED|NO_SHOW|CANCELLED
  confirmCode     String    @unique
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  workedStart     DateTime?
  workedEnd       DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  roster   Roster         @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  guard    Guard?         @relation(fields: [guardId], references: [id])
  site     Site           @relation(fields: [siteId], references: [id])
  template ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  smsLogs  SmsLog[]

  @@index([guardId])
  @@index([siteId])
  @@index([rosterId])
  @@index([templateId])
  @@index([startAt])
}

model SmsLog {
  id          String   @id @default(cuid())
  guardId     String?
  shiftId     String?
  direction   String   // OUTBOUND | INBOUND
  fromNumber  String
  toNumber    String
  body        String
  providerSid String?
  status      String?  // queued|sent|delivered|failed|mock
  errorCode   String?
  receivedAt  DateTime @default(now())

  guard Guard? @relation(fields: [guardId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([guardId])
  @@index([direction])
  @@index([receivedAt])
}

model Timesheet {
  id         String    @id @default(cuid())
  guardId    String
  weekStart  DateTime
  weekEnd    DateTime
  totalHours Decimal
  totalPay   Decimal
  status     String    @default("DRAFT") // DRAFT | APPROVED | PAID
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())

  @@unique([guardId, weekStart])
}

model Setting {
  companyId String
  key       String
  value     String
  company   Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
}
